rules_version = '2';

// Cada persona lee y escribe lo suyo, dentro de users/{suId}.
// Excepción: un profesional activo (entrenador, nutricionista…) ve los datos de sus clientes
// solo mientras el vínculo esté activo. El vínculo lo crea el cliente al ingresar el código (así da su permiso)
// y cualquiera de los dos lo puede cortar.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return conSesion() && request.auth.uid == uid;
    }

    function esAdmin() {
      return conSesion() && exists(/databases/$(database)/documents/config/admins)
        && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    function profesionalActivo(pid) {
      let p = /databases/$(database)/documents/profesionales/$(pid);
      return exists(p) && get(p).data.activo == true;
    }

    // ¿Quien pide es el profesional de este cliente, con vínculo activo?
    function esSuProfesional(uid) {
      let v = /databases/$(database)/documents/vinculos/$(request.auth.uid + '_' + uid);
      return conSesion() && request.auth.uid != uid && exists(v) && get(v).data.activo == true
        && profesionalActivo(request.auth.uid);
    }

    function puedeVer(uid) {
      return esDueno(uid) || esSuProfesional(uid);
    }

    // Solo cambian estas claves respecto de lo guardado
    function soloCambia(claves) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(claves);
    }

    function perfilValido(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'nombre', 'email', 'tema', 'unidad', 'recordatorio', 'creado', 'resumen', 'sobrecarga'])
        && (!('uid' in d) || d.uid == uid)
        && (!('nombre' in d) || (d.nombre is string && d.nombre.size() <= 80))
        && (!('tema' in d) || d.tema in ['claro', 'oscuro', 'sistema'])
        && (!('unidad' in d) || d.unidad in ['kg', 'lb'])
        && (!('resumen' in d) || (d.resumen.dias is list && d.resumen.total is int))
        && (!('sobrecarga' in d) || d.sobrecarga.modo in ['auto', 'manual', 'apagada']);
    }

    function rutinaValida() {
      let d = request.resource.data;
      return d.nombre is string && d.nombre.size() <= 80
        && d.ejercicios is list && d.ejercicios.size() <= 40;
    }

    match /users/{uid} {
      allow read: if puedeVer(uid);
      allow delete: if esDueno(uid);
      allow create, update: if esDueno(uid) && perfilValido(uid);

      // Rutinas: el cliente maneja las suyas; las asignadas por su profesional solo las maneja el profesional
      match /routines/{id} {
        allow read: if puedeVer(uid);
        allow create: if rutinaValida() && (
          (esDueno(uid) && !('asignadaPor' in request.resource.data))
          || (esSuProfesional(uid) && request.resource.data.asignadaPor == request.auth.uid));
        allow update: if rutinaValida() && (
          (esDueno(uid) && !('asignadaPor' in resource.data) && !('asignadaPor' in request.resource.data))
          || (esSuProfesional(uid) && resource.data.asignadaPor == request.auth.uid
              && request.resource.data.asignadaPor == request.auth.uid));
        // El cliente puede quitarla (por ejemplo al dejar al entrenador); el profesional, solo las suyas
        allow delete: if esDueno(uid) || (esSuProfesional(uid) && resource.data.asignadaPor == request.auth.uid);
      }
      match /customExercises/{id} {
        allow read: if puedeVer(uid);
        allow delete: if esDueno(uid);
        allow create, update: if puedeVer(uid)
          && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80;
      }
      match /workouts/{id} {
        allow read: if puedeVer(uid);
        allow delete: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && request.resource.data.inicio is number && request.resource.data.fin is number
          && request.resource.data.ejercicios is list && request.resource.data.ejercicios.size() <= 60;
      }
      match /exerciseStats/{id} {
        allow read: if puedeVer(uid);
        allow delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && request.resource.data.puntos is list && request.resource.data.puntos.size() <= 200;
      }
      match /bodyLogs/{id} {
        allow read: if puedeVer(uid);
        allow delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && request.resource.data.fecha is number;
      }

      // Comentarios entre el profesional y el cliente. Cada uno escribe los suyos; el cliente marca "leído".
      match /comments/{id} {
        allow read: if puedeVer(uid);
        allow create: if puedeVer(uid)
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 1000;
        allow update: if (esDueno(uid) && soloCambia(['leido']))
          || (puedeVer(uid) && resource.data.autorId == request.auth.uid && soloCambia(['texto', 'leido']));
        allow delete: if esDueno(uid) || (puedeVer(uid) && resource.data.autorId == request.auth.uid);
      }

      // Objetivos: los fija el profesional; el cliente los ve (y puede borrarlos si ya no tiene profesional)
      match /goals/{id} {
        allow read: if puedeVer(uid);
        allow create, update: if esSuProfesional(uid)
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 120
          && request.resource.data.tipo in ['frecuencia', 'marca', 'corporal', 'libre'];
        allow delete: if esDueno(uid) || esSuProfesional(uid);
      }
    }

    // Profesionales: los da de alta y de baja solo el admin
    match /profesionales/{pid} {
      allow read: if esDueno(pid) || esAdmin();
      allow write: if esAdmin();
    }

    // Códigos de invitación: se consultan de a uno (no se pueden listar)
    match /codigos/{codigo} {
      allow get: if conSesion();
      allow list: if esAdmin();
      allow write: if esAdmin();
    }

    // Pedido para ser profesional: lo hace el propio usuario; lo resuelve el admin
    match /solicitudes/{uid} {
      allow read: if esDueno(uid) || esAdmin();
      allow create: if esDueno(uid)
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.tipo in ['entrenador', 'nutricionista']
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80
        && (!('mensaje' in request.resource.data) || request.resource.data.mensaje.size() <= 500);
      allow update: if esAdmin() || (esDueno(uid) && resource.data.estado == 'rechazada'
        && request.resource.data.estado == 'pendiente');
      allow delete: if esAdmin() || esDueno(uid);
    }

    // Vínculo profesional ↔ cliente
    match /vinculos/{id} {
      allow read: if conSesion() && (resource.data.clienteId == request.auth.uid
        || resource.data.profesionalId == request.auth.uid || esAdmin());
      // Lo crea el cliente con un código válido de un profesional activo
      allow create: if conSesion()
        && request.resource.data.clienteId == request.auth.uid
        && id == request.resource.data.profesionalId + '_' + request.auth.uid
        && request.resource.data.activo == true
        && request.resource.data.profesionalId != request.auth.uid
        && exists(/databases/$(database)/documents/codigos/$(request.resource.data.codigo))
        && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigo)).data.profesionalId == request.resource.data.profesionalId
        && profesionalActivo(request.resource.data.profesionalId);
      // Cualquiera de los dos lo corta; volver a activarlo solo el cliente, con el código vigente
      allow update: if conSesion() && (
        ((resource.data.clienteId == request.auth.uid || resource.data.profesionalId == request.auth.uid || esAdmin())
          && request.resource.data.activo == false && soloCambia(['activo', 'hasta']))
        || (resource.data.clienteId == request.auth.uid && request.resource.data.activo == true
          && request.resource.data.clienteId == resource.data.clienteId
          && request.resource.data.profesionalId == resource.data.profesionalId
          && exists(/databases/$(database)/documents/codigos/$(request.resource.data.codigo))
          && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigo)).data.profesionalId == request.resource.data.profesionalId
          && profesionalActivo(request.resource.data.profesionalId)));
      allow delete: if false;
    }

    // Lista de admins: la carga el dueño a mano desde la consola de Firebase.
    match /config/admins {
      allow read: if conSesion();
      allow write: if false;
    }
  }
}
