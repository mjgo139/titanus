<?xml version="1.0" encoding="utf-8"?>
<!-- Hasta 3 programas en curso, uno por fila (Widgets.programa) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_fondo" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="34dp" android:layout_height="22dp" android:src="@drawable/widget_emblema"
            android:scaleType="fitCenter" android:contentDescription="StoaGym" />
        <TextView android:id="@+id/prog_titulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
            android:letterSpacing="0.14" android:text="TUS PROGRAMAS" android:textColor="#FFF2C55C" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/prog_fila0" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/prog_nombre0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:ellipsize="end" android:fontFamily="serif" android:maxLines="1" android:text="Más dominadas"
                android:textColor="#FFF7F1E7" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/prog_pct0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:fontFamily="serif" android:text="25 %" android:textColor="#FFF2C55C" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar android:id="@+id/prog_barra0" style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="4dp" android:max="12" android:progress="3"
            android:progressDrawable="@drawable/widget_barra" />
        <TextView android:id="@+id/prog_detalle0" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text="Sesión 4 de 12 · Tirón"
            android:textColor="#FFC9BDA7" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/prog_fila1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/prog_nombre1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:ellipsize="end" android:fontFamily="serif" android:maxLines="1" android:text="Abdomen de acero"
                android:textColor="#FFF7F1E7" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/prog_pct1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:fontFamily="serif" android:text="50 %" android:textColor="#FFF2C55C" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar android:id="@+id/prog_barra1" style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="4dp" android:max="12" android:progress="6"
            android:progressDrawable="@drawable/widget_barra" />
        <TextView android:id="@+id/prog_detalle1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text="Sesión 7 de 12 · Núcleo"
            android:textColor="#FFC9BDA7" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/prog_fila2" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/prog_nombre2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:ellipsize="end" android:fontFamily="serif" android:maxLines="1" android:text=""
                android:textColor="#FFF7F1E7" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/prog_pct2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:fontFamily="serif" android:text="" android:textColor="#FFF2C55C" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar android:id="@+id/prog_barra2" style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="4dp" android:max="12" android:progress="0"
            android:progressDrawable="@drawable/widget_barra" />
        <TextView android:id="@+id/prog_detalle2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text=""
            android:textColor="#FFC9BDA7" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
